{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    { "source": "/despacho-abogados-lugo/", "destination": "/#despacho", "permanent": true },
    { "source": "/areas-de-practica/", "destination": "/#areas", "permanent": true },
    { "source": "/abogados-derecho-penal-lugo/", "destination": "/#penal", "permanent": true },
    { "source": "/abogados-derecho-mercantil-concursal-lugo/", "destination": "/#mercantil", "permanent": true },
    { "source": "/abogados-derecho-tributario-lugo/", "destination": "/#tributario", "permanent": true },
    { "source": "/abogados-derecho-civil-procesal-lugo/", "destination": "/#civil", "permanent": true },
    { "source": "/abogados-derecho-adminitrativo-lugo/", "destination": "/#administrativo", "permanent": true },
    { "source": "/abogados-derecho-laboral-lugo/", "destination": "/#laboral", "permanent": true },
    { "source": "/(e|E)quipo-profesional/", "destination": "/#equipo", "permanent": true },
    { "source": "/(e|E)quipo-profesional/:slug*", "destination": "/#equipo", "permanent": true },
    { "source": "/actualidad-juridica/:path*", "destination": "/#actualidad", "permanent": true },
    { "source": "/contacto/", "destination": "/#contacto", "permanent": true },
    { "source": "/politica-de-cookies/", "destination": "/politica-de-cookies-ue/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    },
    {
      "source": "/(favicon.svg|apple-touch-icon.png|site.webmanifest)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    }
  ]
}
