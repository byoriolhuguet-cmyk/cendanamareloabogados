# Cendán & Amarelo Abogados — servidor Apache
# Compresión, caché larga para recursos estáticos y cabeceras de seguridad.

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/ld+json image/svg+xml text/plain application/xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(woff2|webp|jpg|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

AddType font/woff2 .woff2
AddType application/manifest+json .webmanifest
AddType image/webp .webp
AddDefaultCharset utf-8
ErrorDocument 404 /404.html

# Redirecciones 301 desde URL antiguas que ya no existen (perfiles individuales del equipo)
<IfModule mod_alias.c>
  RedirectMatch 301 ^/Equipo-profesional/(.*)$ /equipo-profesional/$1
  RedirectMatch 301 ^/politica-de-cookies/?$ /politica-de-cookies-ue/
</IfModule>
